<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Douane Temporelle"
        android:textSize="26sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="24dp" />

    <EditText
        android:id="@+id/et_nom_cm"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Nom du voyageur"
        android:inputType="textPersonName" />

    <EditText
        android:id="@+id/et_naissance_cm"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Année de naissance (ex: 1990)"
        android:inputType="number"
        android:maxLength="4" />

    <EditText
        android:id="@+id/et_destination_cm"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Année de destination (ex: 2050)"
        android:inputType="number"
        android:maxLength="4" />

    <Spinner
        android:id="@+id/sp_motif_cm"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:entries="@array/motifs" />

    <Button
        android:id="@+id/btn_inspecter_cm"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="Inspecter le profil" />
</LinearLayout>
